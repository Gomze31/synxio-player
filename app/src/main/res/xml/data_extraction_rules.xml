<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="synxio.db" />
        <include domain="file" path="datastore" />
        <exclude domain="sharedpref" path="synxio_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="synxio.db" />
        <include domain="file" path="datastore" />
        <exclude domain="sharedpref" path="synxio_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
