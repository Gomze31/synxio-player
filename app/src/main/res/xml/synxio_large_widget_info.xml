<?xml version="1.0" encoding="utf-8"?>
<!-- Widget étendu : grande pochette et commandes complètes, 4x3 par défaut.
     updatePeriodMillis à 0 : republié par le service aux changements d'état seulement. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="220dp"
    android:minResizeHeight="170dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_large"
    android:previewImage="@drawable/widget_preview_image_large"
    android:description="@string/widget_large_description" />
