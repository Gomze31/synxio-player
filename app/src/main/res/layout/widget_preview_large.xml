<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du sélecteur de widgets (Android 12+) : statique, scène Lumen à l'encre.
     Montré en pause : c'est l'état où le widget affiche la progression. -->
<!-- RemoteViews : app:tint (AppCompat) n'y existe pas, android:tint est le bon attribut. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_lumen_preview_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/widget_lumen_preview_art"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_widget_note"
            android:tint="#B3FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_eyebrow_paused"
                android:textAllCaps="true"
                android:textColor="#FFFF8A4C"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_title"
                android:textColor="#FFF6F1EC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_artist"
                android:textColor="#FFBDB4AF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="14dp"
        android:progress="40"
        android:progressBackgroundTint="#29FFFFFF"
        android:progressTint="#FFFF8A4C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_shuffle"
            android:tint="#FFBDB4AF" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_previous"
            android:tint="#FFF6F1EC" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_lumen_preview_play" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_next"
            android:tint="#FFF6F1EC" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_repeat"
            android:tint="#FFBDB4AF" />
    </LinearLayout>
</LinearLayout>
