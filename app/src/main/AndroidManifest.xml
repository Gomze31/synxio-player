<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lecture de la bibliothèque locale -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Facultative, demandée depuis les réglages : images de pochette posées dans les dossiers -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Service de lecture en avant-plan -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Réveil en musique : alarme exacte (API 33+ : USE_EXACT_ALARM, accordée d'office
         aux applis de réveil) et reprogrammation au démarrage du téléphone. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Égaliseur / effets audio -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Écouteurs Bluetooth (Galaxy Buds) : batterie et codec, diffusés par la pile
        Bluetooth aux seules applis qui ont BLUETOOTH_CONNECT. Facultative, demandée depuis
        la carte Galaxy Buds des réglages.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Mise à jour interne depuis les releases GitHub.

        Google Play restreint fortement cette permission : une application publiée sur le
        Store se met à jour par le Store. Elle vise ici la distribution directe de l'APK.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Scrobbling Last.fm + paroles en ligne -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        « Définir comme sonnerie » : RingtoneManager.setActualDefaultRingtoneUri exige
        WRITE_SETTINGS, accordée par l'utilisateur via ACTION_MANAGE_WRITE_SETTINGS.
        Sans cette déclaration, l'écran système ne propose même pas l'autorisation.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Visibilité du client Discord.

        Depuis Android 11, une application ne voit pas les autres paquets installés sans
        le déclarer. Sans ce bloc, `bindService` vers Discord échouerait silencieusement,
        exactement comme si Discord n'était pas installé. Galaxy Wearable : raccourci vers
        les réglages des Galaxy Buds (réduction de bruit, son ambiant).
    -->
    <queries>
        <package android:name="com.discord" />
        <package android:name="com.samsung.android.app.watchmanager" />
        <intent>
            <action android:name="com.discord.socialsdk.rpc.IDiscordRpcService" />
        </intent>
    </queries>

    <application
        android:name=".SynxioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Synxio.Splash"
        tools:targetApi="34">

        <!-- Google Cast Options Provider -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="fr.synxio.player.playback.CastOptionsProvider" />

        <!-- Déclare l'app comme compatible Android Auto -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_stat_music" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.Synxio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!-- Ouvrir un fichier audio depuis un explorateur -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
            </intent-filter>

            <!-- Recherche vocale « Joue <artiste> » -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Appui long sur la tuile des Réglages rapides -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>

            <!-- Raccourcis d'appui long sur l'icône -->
            <intent-filter>
                <action android:name="fr.synxio.player.SHUFFLE_ALL" />
                <action android:name="fr.synxio.player.PLAY_FAVORITES" />
                <action android:name="fr.synxio.player.RESUME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Tuile des Réglages rapides : lecture / pause -->
        <service
            android:name=".playback.PlaybackTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_music"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Widget écran d'accueil (Glance) -->
        <receiver
            android:name=".widget.SynxioWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/synxio_widget_info" />
        </receiver>

        <!-- Grand Widget écran d'accueil -->
        <receiver
            android:name=".widget.SynxioLargeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/synxio_large_widget_info" />
        </receiver>

        <!-- Partage de la carte « en écoute » : périmètre défini dans res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Pochettes lisibles par Android Auto, l'écran de verrouillage et le Bluetooth.
            Exporté en lecture seule : il ne sert que les pochettes de la cascade, les images
            de dossier et les logos des radios favorites (voir ArtworkProvider).
        -->
        <provider
            android:name=".playback.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Réveil en musique -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".alarm.AlarmBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Boutons média des casques filaires / Bluetooth -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
